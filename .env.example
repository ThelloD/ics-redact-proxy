# ============================================================
# ICS Redact Proxy configuration
# ============================================================

# Source iCal URL.
ICS_SOURCE_URL=https://username:password@example.com/calendar.ics


# Allowed calendar fields.
# Default: PRODID,VERSION,CALSCALE,METHOD,X-WR-CALNAME,X-WR-TIMEZONE,NAME
# ICS_CALENDAR_FIELDS=PRODID,VERSION,CALSCALE,METHOD,X-WR-CALNAME,X-WR-TIMEZONE,NAME


# Allowed event/component fields.
# Default: CREATED,DTEND,DTSTART,DTSTAMP,EXDATE,EXRULE,LAST-MODIFIED,RDATE,RRULE,SEQUENCE,STATUS,TRANSP,UID,RECURRENCE-ID
# ICS_COMPONENT_FIELDS=CREATED,DTEND,DTSTART,DTSTAMP,EXDATE,EXRULE,LAST-MODIFIED,RDATE,RRULE,SEQUENCE,STATUS,TRANSP,UID,RECURRENCE-ID


# Allowed calendar components.
# Default: VTIMEZONE,VEVENT
# ICS_COMPONENTS=VTIMEZONE,VEVENT


# Replace event UIDs with hashes.
# Recommended because UIDs may expose domains/IP addresses.
# Default: true
# ICS_HASH_UID=true


# Skip TLS certificate verification when fetching the source URL.
# Default: false
# ICS_INSECURE_SKIP_TLS_VERIFY=false


# Address the application listens on.
# Default: :3000
# ICS_LISTEN_ADDRESS=:3000


# Log format.
# Valid values: auto, color, plain, json
# Default: auto
# ICS_LOG_FORMAT=auto


# Log level.
# Valid values: trace, debug, info, warn, error
# Default: info
# ICS_LOG_LEVEL=info


# Replace the calendar name.
# Default: ""
# ICS_NEW_CALENDAR_NAME=


# Replace all event summaries.
# Default: Unavailable
# ICS_NEW_EVENT_SUMMARY=Unavailable


# Skip source verification during startup.
# Default: false
# ICS_NO_VERIFY=false


# Sliding-window interval used by the rate limiter.
# Default: 10s
# ICS_RATE_LIMIT_INTERVAL=10s


# Maximum number of requests per IP during the rate-limit interval.
# Default: 5
# ICS_RATE_LIMIT_MAX_REQUESTS=5


# Obtain the client IP from the Real-IP header.
# Default: true
# ICS_REAL_IP_HEADER=true


# TLS certificate path.
# Default: ""
# ICS_TLS_CERT_PATH=


# TLS private-key path.
# Default: ""
# ICS_TLS_KEY_PATH=


# Enables token authentication.
# Requests must contain ?token=<token>.
# Default: ""
# ICS_TOKEN=

